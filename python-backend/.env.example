# ARIA Python Backend Configuration

# OpenAI API Key (optional, for cloud fallback)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (Claude) API Key (optional, alternative to OpenAI)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Ollama Configuration
# Set to http://localhost:11434 if running Ollama locally
OLLAMA_URL=http://localhost:11434

# Python Backend Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
